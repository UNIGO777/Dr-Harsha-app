# ─────────────────────────────────────────────────────────────
# Sanchara — clinical portal (admin web app)
# Copy to `.env` (or .env.local) if you need to override the defaults.
# ─────────────────────────────────────────────────────────────

# DEV: which backend the Vite proxy forwards /api to.
# Leave unset to use http://localhost:5000.
# macOS note: port 5000 is taken by the AirPlay Receiver — if you run the
# backend on another port, point this at it, e.g. http://localhost:5055
VITE_API_PROXY=http://localhost:5000

# PRODUCTION ONLY: absolute API base URL used by the built app.
# Unset in dev so requests stay same-origin and go through the proxy above.
# VITE_API_URL=https://api.sanchara.app/api
