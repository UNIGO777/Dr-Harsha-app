# Sanchara frontend environment.
# Copy to `.env` and adjust. Only vars prefixed with EXPO_PUBLIC_ are exposed to
# the app bundle at build time (Expo convention).

# Base URL of the Sanchara backend (Node/Express monolith).
# Physical device: use your Mac's LAN IP (e.g. http://192.168.1.2:5000/api).
# Android emulator: http://10.0.2.2:5000/api. iOS simulator: http://localhost:5000/api.
# NOTE: macOS AirPlay Receiver hijacks port 5000 (returns 403 Server: AirTunes),
# so this project runs the backend on 5055 — keep this port in sync with the
# backend's PORT in Sanchara-backend/backend/.env.
EXPO_PUBLIC_API_URL=http://192.168.1.2:5055/api

# Clinic contact for the "Book a consultation" sheet (OPTIONAL).
# When set, the sheet shows working Call + WhatsApp buttons; when unset they are
# hidden rather than rendered dead. E.164, e.g. +919876543210
EXPO_PUBLIC_CLINIC_PHONE=
