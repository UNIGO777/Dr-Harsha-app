# Sanchara frontend environment.
# Copy to `.env` and adjust. Only vars prefixed with EXPO_PUBLIC_ are exposed to
# the app bundle at build time (Expo convention).

# Base URL of the Sanchara backend (Node/Express monolith).
# Physical device: use your Mac's LAN IP (e.g. http://192.168.1.2:5000/api).
# Android emulator: http://10.0.2.2:5000/api. iOS simulator: http://localhost:5000/api.
# NOTE: macOS AirPlay Receiver hijacks port 5000 — if you get 403s, run the
# backend on another port (e.g. 5055) and match it here.
EXPO_PUBLIC_API_URL=http://192.168.1.2:5000/api
