# ─────────────────────────────────────────────────────────────
# Sanchara — backend environment
# Copy this file to `.env` and fill in the values.
# Required vars: NODE_ENV, PORT, MONGODB_URI, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET
# Third-party secrets are OPTIONAL in the local phase (services are mocked).
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
# NOTE (macOS): port 5000 is used by the AirPlay Receiver and will return
# "403 Forbidden". Either disable it (System Settings → General → AirDrop &
# Handoff → turn off "AirPlay Receiver") or set PORT to e.g. 5055 locally.
# Day-3 trial lockout. Leave false until a payment gateway exists —
# enforcing it without one locks patients out with no way to subscribe.
ENFORCE_TRIAL_LOCKOUT=false

PORT=5000
MONGODB_URI=mongodb://localhost:27017/sanchara

# Auth / JWT (REQUIRED — use long random strings)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (SMTP) — optional in local phase (mocked if blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Uploads
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE_MB=100

# Payments (Razorpay) — optional in local phase (mocked if blank)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI (Anthropic / Claude) — optional in local phase (mocked if blank)
ANTHROPIC_API_KEY=
CHATBOT_DAILY_LIMIT=20

# Push (Firebase) — optional in local phase (mocked if blank)
# Path to the service-account JSON file (kept out of git).
FIREBASE_SERVICE_ACCOUNT=./firebase-admin.json

# ── OTP ───────────────────────────────────────────────────────────────────────
# The SERVER owns the code length and lifetime. Fast2SMS is TOLD these values so
# its template renders matching copy; it never sets them. There is deliberately
# no FAST2SMS_OTP_EXPIRY / FAST2SMS_OTP_LENGTH — a second set of knobs would let
# the SMS advertise a validity window the server does not honour.
OTP_LENGTH=6
OTP_TTL_SECONDS=300

# ── SMS (Fast2SMS) ────────────────────────────────────────────────────────────
# Required in production: OTP is the only way into the app, so the server
# REFUSES TO BOOT with NODE_ENV=production and these unset. Leave blank in local
# dev to fall back to the mock provider (the code is logged to the console).
# FAST2SMS_OTP_ID is the id of your DLT-approved OTP template.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
